---
import Base from '../layouts/Base.astro';
import Chip from '../components/Chip.astro';
import Marquee from '../components/Marquee.astro';
import Schematic from '../components/Schematic.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import ApplyBand from '../components/ApplyBand.astro';
import { hero, datasheet, destinations, partnerInvite, homePhotos, alumniSpotlights } from '../data/home';
import { eventFormats } from '../data/partners';
import { org } from '../data/site';
import { url } from '../lib/url';
---

<Base
  title={org.short}
  description="ECBA is the student association of Texas ECB Honors at UT Austin: students earning degrees in both Electrical and Computer Engineering Honors and Canfield Business Honors."
>
  <section class="hero on-dark">
    <div class="wrap hero__inner">
      <div class="hero__copy">
        <p class="hero__kicker">{hero.kicker}</p>
        <h1 class="display">
          <span class="voice-eng">{hero.headlineEngineering}</span>
          <span class="voice-biz">{hero.headlineBusiness}</span>
        </h1>
        <p class="lead hero__intro">{hero.intro}</p>
        <div class="btn-row hero__actions">
          <a class="btn btn--solid" href={url('/partners')}>Partner with us</a>
          <a class="btn btn--line" href={url('/apply')}>Apply to Texas ECB</a>
        </div>
      </div>
      <div class="hero__chip">
        <Chip />
      </div>
    </div>
  </section>

  <section class="datasheet" aria-labelledby="glance-title">
    <div class="wrap">
      <h2 class="visually-hidden" id="glance-title">ECBA at a glance</h2>
      <table class="datasheet__table">
        <thead>
          <tr>
            <th scope="col">Parameter</th>
            <th scope="col">Value</th>
            <th scope="col">Conditions</th>
            <th scope="col">Source</th>
          </tr>
        </thead>
        <tbody>
          {
            datasheet.map((row) => (
              <tr>
                <th scope="row">{row.parameter}</th>
                <td class="datasheet__value voice-eng">{row.value}</td>
                <td>{row.note}</td>
                <td class="datasheet__source">{row.source}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="section work" aria-labelledby="work-title">
    <div class="wrap work__head">
      <h2 class="h-section" id="work-title">
        <span class="voice-eng">Where members work</span>
      </h2>
      <p class="work__text">
        Internships, full-time roles and graduate programs that ECB students have gone on to, across chip design,
        software, finance and consulting.
      </p>
    </div>
    <Marquee items={destinations} label="Companies and programs where ECB students have worked or studied" />
    <div class="wrap">
      <p class="fine soft work__note">
        Names are from ECBA’s own “Where is ECB” board and are shown as text. No endorsement by these organizations is
        implied.
      </p>
    </div>
  </section>

  <section class="section surface-wash pillars" aria-labelledby="pillars-title" style="--surface: var(--pcb-wash)">
    <div class="wrap pillars__inner">
      <div class="pillars__intro">
        <h2 class="h-section" id="pillars-title">
          <span class="voice-eng">What we do</span>
        </h2>
        <p class="lead">Three parts in series. Each one makes the next work better.</p>
      </div>
      <Schematic />
    </div>
  </section>

  <section class="section photos" aria-labelledby="photos-title">
    <div class="wrap">
      <div class="photos__head">
        <h2 class="h-section" id="photos-title">
          <span class="voice-biz">A small program is a close one.</span>
        </h2>
        <a href={url('/events')}>See events and the full gallery</a>
      </div>
      <div class="photos__grid">
        {homePhotos.map((photo, i) => <PhotoSlot class={`photos__item photos__item--${i + 1}`} {...photo} ratio="auto" />)}
      </div>
    </div>
  </section>

  <section class="section surface-board partner on-dark" aria-labelledby="partner-title">
    <div class="wrap partner__inner">
      <div>
        <h2 class="h-section" id="partner-title">
          <span class="voice-eng">Partner with us</span>
          <span class="voice-biz partner__sub">{partnerInvite.title}</span>
        </h2>
        <p class="partner__body">{partnerInvite.body}</p>
        <div class="btn-row partner__actions">
          <a class="btn btn--solid" href={url('/partners')}>See ways to partner</a>
          <a class="btn btn--line" href={url('/partners#inquiry')}>Host an event</a>
        </div>
      </div>
      <ul class="partner__formats" role="list">
        {
          eventFormats.map((format) => (
            <li>
              <span class="via" aria-hidden="true" />
              <div>
                <h3 class="h-item">{format.title}</h3>
                <p class="small soft">{format.length}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section alumni" aria-labelledby="alumni-title">
    <div class="wrap">
      <div class="alumni__head">
        <h2 class="h-section" id="alumni-title">
          <span class="voice-eng">Alumni spotlights</span>
        </h2>
        <p class="notice">
          <strong>Layout preview.</strong> The people below are fictional samples. Real spotlights will show each
          alum’s class year, technical track and current role.
        </p>
      </div>
      <ul class="alumni__list" role="list">
        {
          alumniSpotlights.map((person) => (
            <li class="alum">
              <div class="alum__portrait" aria-hidden="true">
                <svg viewBox="0 0 80 80">
                  <circle cx="40" cy="30" r="14" />
                  <path d="M12 76c2-18 14-26 28-26s26 8 28 26" />
                </svg>
              </div>
              <div class="alum__body">
                <span class="sample-tag">Sample</span>
                <h3 class="h-item alum__name">{person.name}</h3>
                <dl class="alum__facts">
                  <div>
                    <dt>Year</dt>
                    <dd>{person.classYear}</dd>
                  </div>
                  <div>
                    <dt>Track</dt>
                    <dd>{person.track}</dd>
                  </div>
                  <div>
                    <dt>Now</dt>
                    <dd>
                      {person.role}, {person.employer}
                    </dd>
                  </div>
                </dl>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ApplyBand />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle, rgb(181 202 118 / 0.13) 1.2px, transparent 1.6px) 0 0 / 28px 28px,
      var(--pcb-board);
    color: var(--paper);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    align-items: center;
    gap: var(--space-5);
    min-height: min(46rem, calc(100svh - 7.5rem));
    padding-block: var(--space-8);
  }
  .hero__kicker {
    font-weight: 640;
    font-stretch: 110%;
    color: var(--pcb-lime);
  }
  .hero h1 {
    margin-top: var(--space-3);
    font-size: clamp(2.5rem, 0.9rem + 4.1vw, 4.4rem);
  }
  .hero h1 span {
    display: block;
  }
  .hero h1 .voice-biz {
    color: var(--pcb-lime);
    margin-top: 0.04em;
    font-size: 1.1em;
  }
  .hero__intro {
    margin-top: var(--space-5);
    color: var(--pcb-mist);
    font-size: var(--text-md);
    line-height: 1.5;
    max-width: 33em;
  }
  .hero__actions {
    margin-top: var(--space-6);
  }
  .hero__chip {
    display: grid;
    place-items: center;
    translate: 2.5rem 0;
  }

  /* ---------- Datasheet ---------- */
  .datasheet {
    padding-block: var(--space-7) var(--space-2);
  }
  .datasheet__table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }
  .datasheet__table thead th {
    padding: 0 var(--space-4) var(--space-2) 0;
    font-size: var(--text-xs);
    font-weight: 620;
    color: var(--color-text-soft);
    border-bottom: var(--trace) solid var(--pcb-dark);
  }
  .datasheet__table tbody th,
  .datasheet__table td {
    padding: var(--space-4) var(--space-4) var(--space-4) 0;
    border-bottom: 1px solid var(--color-rule);
    vertical-align: baseline;
  }
  .datasheet__table tbody th {
    width: 16%;
    font-weight: 620;
  }
  .datasheet__value {
    width: 31%;
    font-size: var(--text-lg);
    line-height: 1;
    color: var(--pcb-deep);
    white-space: nowrap;
  }
  .datasheet__source {
    font-size: var(--text-xs);
    color: var(--color-text-soft);
  }

  /* ---------- Where members work ---------- */
  .work__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: end;
    gap: var(--space-5) var(--space-7);
    margin-bottom: var(--space-6);
  }
  .work__text {
    max-width: 46ch;
  }
  .work__note {
    max-width: 62ch;
  }

  /* ---------- Pillars ---------- */
  .pillars__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: var(--space-7);
    align-items: start;
  }
  .pillars__intro {
    position: sticky;
    top: var(--space-7);
  }
  .pillars__intro .lead {
    margin-top: var(--space-4);
    font-size: var(--text-md);
    max-width: 18em;
  }

  /* ---------- Photos ---------- */
  .photos__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    margin-bottom: var(--space-6);
  }
  .photos__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: repeat(2, clamp(9rem, 17vw, 15rem));
    gap: var(--space-3);
  }
  .photos__grid :global(.photos__item--1) { grid-column: 1 / span 3; grid-row: 1 / span 2; }
  .photos__grid :global(.photos__item--2) { grid-column: 4 / span 5; grid-row: 1; }
  .photos__grid :global(.photos__item--3) { grid-column: 9 / span 4; grid-row: 1; }
  .photos__grid :global(.photos__item--4) { grid-column: 4 / span 6; grid-row: 2; }
  .photos__grid :global(.photos__item--5) { grid-column: 10 / span 3; grid-row: 2; }

  /* ---------- Partner invitation ---------- */
  .partner__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: var(--space-8);
    align-items: center;
  }
  .partner h2 span {
    display: block;
  }
  .partner__sub {
    margin-top: var(--space-2);
    color: var(--pcb-lime);
    font-size: var(--text-lg);
  }
  .partner__body {
    margin-top: var(--space-5);
    max-width: 54ch;
    color: var(--pcb-mist);
  }
  .partner__actions {
    margin-top: var(--space-6);
  }
  .partner__formats {
    margin: 0;
    border-left: var(--trace) solid var(--pcb-moss);
  }
  .partner__formats li {
    position: relative;
    display: flex;
    gap: var(--space-4);
    padding: var(--space-4) 0 var(--space-4) var(--space-5);
  }
  .partner__formats .via {
    position: absolute;
    left: calc(-0.375rem - 1px);
    top: 1.45rem;
    background: var(--pcb-deep);
  }

  /* ---------- Alumni ---------- */
  .alumni__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-5) var(--space-7);
    align-items: end;
    margin-bottom: var(--space-6);
  }
  .alumni__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin: 0;
  }
  .alum {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: var(--trace) solid var(--pcb-dark);
  }
  .alum__portrait {
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: end center;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--pcb-mist);
  }
  .alum__portrait svg {
    width: 86%;
    fill: var(--pcb-sage);
  }
  .alum__name {
    margin-top: var(--space-2);
  }
  .alum__facts {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }
  .alum__facts div {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    gap: var(--space-2);
    padding-block: 0.3rem;
    border-top: 1px solid var(--color-rule);
  }
  .alum__facts dt {
    color: var(--color-text-soft);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 62rem) {
    .hero__inner {
      grid-template-columns: 1fr;
      min-height: 0;
      padding-block: var(--space-7) 0;
    }
    .hero__chip {
      margin-block: -1rem -3rem;
      translate: none;
    }
    .pillars__inner,
    .partner__inner,
    .work__head,
    .alumni__head {
      grid-template-columns: 1fr;
    }
    .pillars__intro {
      position: static;
    }
    .alumni__list {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
    .partner__inner {
      gap: var(--space-6);
    }
  }

  @media (max-width: 44rem) {
    .datasheet__table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .datasheet__table tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0 var(--space-4);
      padding-block: var(--space-4);
      border-bottom: 1px solid var(--color-rule);
    }
    .datasheet__table tbody th,
    .datasheet__table td {
      width: auto;
      padding: 0;
      border: 0;
    }
    .datasheet__table tbody th {
      grid-column: 1;
      align-self: end;
      font-size: var(--text-sm);
      color: var(--color-text-soft);
    }
    .datasheet__value {
      grid-column: 1;
      grid-row: 2;
      margin-top: var(--space-1);
      font-size: var(--text-lg);
    }
    .datasheet__table td:nth-child(3) {
      grid-column: 1;
      grid-row: 3;
      margin-top: var(--space-1);
    }
    .datasheet__source {
      grid-column: 1;
      grid-row: 4;
      margin-top: var(--space-1);
    }
    .photos__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
      grid-auto-rows: 9.5rem;
    }
    .photos__grid :global(.photos__item) {
      grid-column: auto !important;
      grid-row: auto !important;
    }
    .photos__grid :global(.photos__item--1) {
      grid-row: span 2 !important;
    }
    .photos__grid :global(.photos__item--4),
    .photos__grid :global(.photos__item--5) {
      grid-column: span 2 !important;
    }
  }
</style>
