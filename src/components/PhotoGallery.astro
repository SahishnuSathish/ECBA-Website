---
/**
 * Photo mosaic with a lightbox. Each tile is a button; the lightbox is a native <dialog>
 * with previous/next controls (arrow keys work too).
 */
import PhotoSlot from './PhotoSlot.astro';

interface Item {
  label: string;
  ratio?: string;
  tone?: 'deep' | 'olive' | 'mist';
  src?: string;
}
interface Props {
  items: readonly Item[];
  id?: string;
}
const { items, id = 'gallery' } = Astro.props;
---

<ul class="mosaic" role="list" data-gallery={id}>
  {
    items.map((item, index) => (
      <li class={`mosaic__item mosaic__item--${(index % 8) + 1}`}>
        <button type="button" class="mosaic__button" data-index={index} aria-haspopup="dialog">
          <PhotoSlot label={item.label} tone={item.tone} src={item.src} ratio="auto" inline />
          <span class="visually-hidden">Enlarge: {item.label}</span>
        </button>
      </li>
    ))
  }
</ul>

<dialog class="lightbox" id={`${id}-lightbox`} aria-label="Photo viewer">
  <div class="lightbox__inner on-dark">
    <div class="lightbox__stage">
      {
        items.map((item, index) => (
          <div class="lightbox__slide" data-slide={index} hidden>
            <PhotoSlot label={item.label} tone={item.tone} src={item.src} ratio="3 / 2" />
          </div>
        ))
      }
    </div>
    <div class="lightbox__bar">
      <p class="lightbox__count" aria-live="polite"></p>
      <div class="lightbox__controls">
        <button type="button" class="btn btn--line" data-step="-1">Previous</button>
        <button type="button" class="btn btn--line" data-step="1">Next</button>
        <button type="button" class="btn btn--solid" data-close-dialog>Close</button>
      </div>
    </div>
  </div>
</dialog>

<script>
  import { wireDialogs } from '../scripts/dialogs';
  wireDialogs();

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const dialog = document.getElementById(`${gallery.dataset.gallery}-lightbox`);
    if (!(dialog instanceof HTMLDialogElement)) return;
    const slides = Array.from(dialog.querySelectorAll<HTMLElement>('[data-slide]'));
    const count = dialog.querySelector<HTMLElement>('.lightbox__count');
    let current = 0;

    const show = (index: number) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => (slide.hidden = i !== current));
      const label = slides[current].querySelector('.photo__label')?.textContent ?? slides[current].querySelector('img')?.alt ?? '';
      if (count) count.textContent = `${current + 1} of ${slides.length}${label ? `: ${label}` : ''}`;
    };

    gallery.querySelectorAll<HTMLButtonElement>('.mosaic__button').forEach((button) => {
      button.addEventListener('click', () => {
        show(Number(button.dataset.index));
        dialog.showModal();
      });
    });
    dialog.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((button) => {
      button.addEventListener('click', () => show(current + Number(button.dataset.step)));
    });
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') show(current + 1);
      if (event.key === 'ArrowLeft') show(current - 1);
    });
  });
</script>

<style>
  .mosaic {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: clamp(5rem, 9vw, 8.5rem);
    gap: var(--space-3);
    margin: 0;
  }
  .mosaic__item--1 { grid-column: span 6; grid-row: span 3; }
  .mosaic__item--2 { grid-column: span 3; grid-row: span 3; }
  .mosaic__item--3 { grid-column: span 3; grid-row: span 2; }
  .mosaic__item--4 { grid-column: span 3; grid-row: span 4; }
  .mosaic__item--5 { grid-column: span 3; grid-row: span 2; }
  .mosaic__item--6 { grid-column: span 6; grid-row: span 2; }
  .mosaic__item--7 { grid-column: span 5; grid-row: span 2; }
  .mosaic__item--8 { grid-column: span 4; grid-row: span 2; }

  .mosaic__button {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .mosaic__button :global(.photo) {
    height: 100%;
    transition: filter var(--dur-fast) var(--ease-out);
  }
  .mosaic__button:hover :global(.photo) {
    filter: brightness(1.06);
  }

  .lightbox {
    width: min(64rem, calc(100vw - 1.5rem));
    max-height: calc(100dvh - 1.5rem);
    padding: 0;
    border: 0;
    border-radius: var(--radius-md);
    background: var(--pcb-board);
    color: var(--paper);
    overflow: auto;
  }
  .lightbox::backdrop {
    background: rgb(15 22 9 / 0.82);
  }
  .lightbox__inner {
    padding: var(--space-4);
  }
  .lightbox__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .lightbox__count {
    font-size: var(--text-sm);
  }
  .lightbox__controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .lightbox__controls .btn {
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
  }

  @media (max-width: 46rem) {
    .mosaic {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 9rem;
    }
    .mosaic__item {
      grid-column: span 1 !important;
      grid-row: span 1 !important;
    }
    .mosaic__item--1,
    .mosaic__item--6 {
      grid-column: span 2 !important;
    }
  }
</style>
