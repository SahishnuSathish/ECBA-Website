---
/**
 * One photograph per technical core, cropped to 4:3 in src/assets/cores and named by core id.
 * Credits and licenses live with each core in src/data/program.ts and are listed in
 * docs/CONTENT.md.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  /** Leave empty where the photo sits beside text that already names the core. */
  alt?: string;
  /** The photo is cropped to cover its box, so give the rendered image width, not the box width. */
  sizes: string;
}
const { id, alt = '', sizes } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/cores/*.jpg', { eager: true });
const photo = files[`../assets/cores/${id}.jpg`]?.default;
if (!photo) throw new Error(`No photo for technical core "${id}" in src/assets/cores`);
---

<Image class="core-photo" src={photo} alt={alt} widths={[400, 800, photo.width]} sizes={sizes} />

<style>
  .core-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
