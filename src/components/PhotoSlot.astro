---
/**
 * A photograph, or a deliberate placeholder while ECBA gathers real photos.
 * Pass `src` to show an image; `label` doubles as its alt text.
 */
interface Props {
  label: string;
  ratio?: string;
  tone?: 'deep' | 'olive' | 'mist';
  src?: string;
  class?: string;
  /** Render with span elements so the slot can sit inside a button. */
  inline?: boolean;
}
const { label, ratio = '4 / 3', tone = 'mist', src, class: className, inline = false } = Astro.props;
const Frame = inline ? 'span' : 'figure';
const Caption = inline ? 'span' : 'figcaption';
---

<Frame class:list={['photo', `photo--${tone}`, className]} style={`aspect-ratio: ${ratio}`}>
  {
    src ? (
      <img src={src} alt={label} loading="lazy" decoding="async" />
    ) : (
      <>
        <svg class="photo__mark" viewBox="0 0 48 48" aria-hidden="true">
          <rect x="6" y="12" width="36" height="26" rx="2" />
          <circle cx="24" cy="25" r="7" />
          <path d="M16 12l3-5h10l3 5" />
        </svg>
        <Caption class="photo__caption">
          <span class="photo__status">Photo to come</span>
          <span class="photo__label">{label}</span>
        </Caption>
      </>
    )
  }
</Frame>

<style>
  .photo {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background-color: var(--slot-bg);
    background-image:
      linear-gradient(135deg, transparent 0 62%, var(--slot-line) 62% calc(62% + 1px), transparent calc(62% + 1px)),
      linear-gradient(135deg, transparent 0 74%, var(--slot-line) 74% calc(74% + 1px), transparent calc(74% + 1px)),
      linear-gradient(135deg, transparent 0 86%, var(--slot-line) 86% calc(86% + 1px), transparent calc(86% + 1px));
    color: var(--slot-fg);
  }
  .photo--deep {
    --slot-bg: var(--pcb-deep);
    --slot-fg: var(--pcb-mist);
    --slot-line: rgb(181 202 118 / 0.28);
  }
  .photo--olive {
    --slot-bg: var(--pcb-sage);
    --slot-fg: var(--pcb-ink);
    --slot-line: rgb(24 34 15 / 0.22);
  }
  .photo--mist {
    --slot-bg: var(--pcb-mist);
    --slot-fg: var(--pcb-dark);
    --slot-line: rgb(72 85 49 / 0.25);
  }
  .photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo__mark {
    width: clamp(2rem, 14%, 3.25rem);
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    opacity: 0.55;
  }
  .photo__caption {
    position: absolute;
    left: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-xs);
    line-height: 1.35;
    text-align: left;
  }
  .photo__status {
    font-weight: 700;
    font-stretch: 108%;
  }
</style>
