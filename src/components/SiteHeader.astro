---
import EcbaLogo from './EcbaLogo.astro';
import { nav, org } from '../data/site';
import { url } from '../lib/url';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.slice(base.length).replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href;
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="identity" href={url('/')} aria-label={`${org.short} home`}>
      <EcbaLogo />
      <span class="identity__name">
        Electrical Computer Engineering<br />and Business Association
      </span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="menu-toggle__icon" aria-hidden="true"></span>
      <span class="menu-toggle__label">Menu</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="site-nav__cta">
          <a class="btn btn--solid" href={url('/apply')} aria-current={isCurrent('/apply') ? 'page' : undefined}>
            Apply
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const header = document.querySelector<HTMLElement>('.site-header');
  if (toggle && header) {
    const label = toggle.querySelector('.menu-toggle__label');
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      header.classList.toggle('is-open', open);
      if (label) label.textContent = open ? 'Close' : 'Menu';
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 56rem)').addEventListener('change', () => setOpen(false));
  }
</script>

<style>
  .site-header {
    position: relative;
    z-index: var(--z-header);
    background: var(--paper);
    border-bottom: var(--trace) solid var(--pcb-dark);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 5rem;
  }

  .identity {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-3);
    color: var(--pcb-ink);
    text-decoration: none;
  }
  .identity__name {
    padding-left: var(--space-4);
    border-left: 1px solid var(--color-rule);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.3;
    font-stretch: 104%;
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
  }
  .site-nav a:not(.btn) {
    position: relative;
    display: block;
    padding: 0.6rem 0.9rem;
    color: var(--pcb-ink);
    font-weight: 620;
    font-stretch: 106%;
    text-decoration: none;
  }
  .site-nav a:not(.btn):hover {
    color: var(--pcb-olive);
  }
  /* The current page is marked by a via seated on the header trace. */
  .site-nav a[aria-current='page']:not(.btn)::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: calc(-1.02rem - var(--trace));
    width: 0.8rem;
    height: 0.8rem;
    margin-left: -0.4rem;
    border-radius: 50%;
    border: 3px solid var(--pcb-dark);
    background: var(--pad-gold);
  }
  .site-nav__cta {
    margin-left: var(--space-3);
  }
  .site-nav__cta .btn {
    min-height: 2.5rem;
    padding: 0.5rem 1.1rem;
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.75rem;
    padding: 0.5rem 0.9rem;
    border: 2px solid var(--pcb-deep);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--pcb-deep);
    font-weight: 680;
    cursor: pointer;
  }
  .menu-toggle__icon {
    position: relative;
    width: 1.1rem;
    height: 2px;
    background: currentColor;
    box-shadow:
      0 -6px 0 currentColor,
      0 6px 0 currentColor;
  }
  .is-open .menu-toggle__icon {
    box-shadow: none;
    transform: rotate(45deg);
  }
  .is-open .menu-toggle__icon::after {
    content: '';
    position: absolute;
    inset: 0;
    background: currentColor;
    transform: rotate(90deg);
  }

  @media (max-width: 61.99rem) {
    .identity__name {
      display: none;
    }
  }

  @media (max-width: 55.99rem) {
    .site-header__inner {
      flex-wrap: wrap;
      row-gap: 0;
      min-height: 4.25rem;
    }
    .site-nav {
      flex-basis: 100%;
      padding-bottom: var(--space-4);
    }
    .site-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .site-nav a:not(.btn) {
      padding: 0.85rem 0;
      border-top: 1px solid var(--color-rule);
      font-size: var(--text-md);
    }
    .site-nav a[aria-current='page']:not(.btn)::after {
      left: auto;
      right: 0.25rem;
      bottom: 50%;
      margin: 0 0 -0.4rem;
    }
    .site-nav__cta {
      margin: var(--space-3) 0 0;
    }
    .site-nav__cta .btn {
      width: 100%;
      min-height: 3rem;
    }
    /* With JavaScript the menu collapses behind the toggle; without it, it stays open. */
    :global(.js) .menu-toggle {
      display: inline-flex;
    }
    :global(.js) .site-nav {
      display: none;
    }
    :global(.js) .is-open .site-nav {
      display: block;
    }
  }
</style>
